IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_app_password
IMAP_MAILBOX=INBOX

# Daily report time in your local timezone
TZ=Europe/Prague
REPORT_HOUR=18
REPORT_MINUTE=00

# Useful optional behavior flags
UNREAD_ONLY=true
REPORT_ON_STARTUP=false

# CSV lists
IMPORTANT_SUBJECT_KEYWORDS=urgent,invoice,deadline,action required,meeting,security,failed
IMPORTANT_SENDER_ALLOWLIST=boss@company.com,client@customer.com
EXCLUDE_SUBJECT_KEYWORDS=newsletter,promo,advertisement

# Discord bot API (preferred over webhook)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678

# Local LLM endpoint (Ollama)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# Optional safety cap
MAX_MESSAGES=30

# State file to prevent duplicate reports
STATE_PATH=.state/processed_hashes.json
